{
  "data_root": "TableShift Dataset",
  "output_root": "outputs",
  "checkpoint_root": "outputs/checkpoints",
  "cache": {
    "enabled": true,
    "dir": "outputs/cache/preprocessed"
  },
  "datasets": [
    "assistments",
    "nhanes_lead",
    "brfss_diabetes",
    "acsfoodstamps",
    "physionet",
    "acsunemployment"
  ],
  "baselines": {
    "mlp": {
      "method_name": "ERM-MLP",
      "model": {
        "hidden_dims": [256, 128],
        "dropout": 0.1
      },
      "training": {
        "epochs": 50,
        "batch_size": 512,
        "lr": 0.001,
        "weight_decay": 0.0001,
        "patience": 8,
        "use_pos_weight": true,
        "num_workers": 0,
        "log_every": 1
      }
    },
    "xgboost": {
      "method_name": "XGBoost",
      "params": {
        "n_estimators": 500,
        "max_depth": 4,
        "learning_rate": 0.03,
        "subsample": 0.8,
        "colsample_bytree": 0.8,
        "objective": "binary:logistic",
        "eval_metric": "logloss",
        "tree_method": "hist",
        "n_jobs": 8,
        "auto_scale_pos_weight": true
      }
    },
    "ft_transformer": {
      "method_name": "FT-Transformer",
      "model": {
        "constructor": "default",
        "n_blocks": 3
      },
      "training": {
        "epochs": 50,
        "batch_size": 1024,
        "lr": 0.0001,
        "weight_decay": 0.00001,
        "patience": 8,
        "use_pos_weight": true,
        "num_workers": 0,
        "log_every": 1
      }
    }
  },
  "evaluation": {
    "threshold": 0.5,
    "selection_metric": "val_balanced_accuracy"
  },
  "tta": {
    "simple_mlp": {
      "batch_size": 1024,
      "lr": 0.0001,
      "weight_decay": 0.0,
      "steps_per_batch": 1,
      "entropy_weight": 0.1,
      "pseudo_label_weight": 1.0,
      "confidence_threshold": 0.9,
      "update_scope": "head",
      "max_batches": null
    },
    "safe_lc_mlp": {
      "batch_size": 1024,
      "lr": 0.0001,
      "weight_decay": 0.0,
      "steps_per_batch": 1,
      "entropy_weight": 0.05,
      "prior_weight": 0.0,
      "anchor_weight": 0.01,
      "confidence_threshold": 0.8,
      "confident_prior_weight": 0.5,
      "min_confident_fraction": 0.5,
      "prior_strength": 0.0,
      "max_prior_shift": 0.0,
      "update_scope": "head_bn",
      "max_batches": null
    }
  },
  "seeds": [42, 3407, 2004]
}
